# RAGFlow 自托管配置模板
# 复制为 .env 后使用：cp .env.example .env
# .env 已被根 .gitignore 忽略，不要把真实密码提交进 Git。

# 镜像版本（与实测版本一致）
# 完整版内置 BAAI/bge-large-zh-v1.5 等 embedding 模型，无外部模型 key 也能建 dataset；
# 若改用 -slim 版，必须额外配置外部 embedding 服务，否则创建 dataset 会失败。
RAGFLOW_IMAGE=infiniflow/ragflow:v0.20.5
STACK_VERSION=8.11.3
# MinIO 官方已停止发布免费镜像（Docker Hub 仓库下线、quay.io 需登录），
# 这里用社区重建版 pgsty/minio，二进制与命令行为与官方一致。
MINIO_IMAGE=pgsty/minio:latest

# 宿主机端口（避开本机已占用的 3000/3001/3002）
SVR_HTTP_PORT=9380        # HTTP API（容器 9380）
SVR_WEB_PORT=18080        # Web UI（容器 80）
MYSQL_PORT=5455
ES_PORT=1200
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
REDIS_PORT=16379

# 时区
TIMEZONE=Asia/Shanghai

# HuggingFace 镜像（国内网络建议保留）
HF_ENDPOINT=https://hf-mirror.com

# 内存上限（Elasticsearch）
MEM_LIMIT=4294967296

# 数据库 / 对象存储 / 缓存密码，首次部署前改成随机值
MYSQL_DBNAME=rag_flow
MYSQL_PASSWORD=change-me-mysql
MINIO_USER=rag_flow
MINIO_PASSWORD=change-me-minio
REDIS_PASSWORD=change-me-redis
ELASTIC_PASSWORD=change-me-elastic

# 是否开放注册（首次部署需要注册管理员账号，建好 API key 后可改为 0）
REGISTER_ENABLED=1
