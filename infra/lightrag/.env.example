# 本机 LightRAG 配置（ADR-010）；.env 不提交
HOST=127.0.0.1
PORT=9621
WORKING_DIR=./data/rag_storage
INPUT_DIR=./data/inputs

# LLM：本机 Ollama
LLM_BINDING=ollama
LLM_MODEL=deepseek-r1:7b
LLM_BINDING_HOST=http://127.0.0.1:11434
LLM_BINDING_API_KEY=ollama
LLM_TIMEOUT=300
OLLAMA_LLM_THINK=false

# Embedding：与 RAGFlow 共用 bge-large-zh-v1.5，经本地 OpenAI 兼容服务
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BINDING_HOST=http://127.0.0.1:9381/v1
EMBEDDING_BINDING_API_KEY=local-embedding
EMBEDDING_TIMEOUT=120
EMBEDDING_FUNC_MAX_ASYNC=4
EMBEDDING_BATCH_NUM=8

# 单机 CPU 上的并发与语言
MAX_ASYNC=2
MAX_PARALLEL_INSERT=1
MAX_ASYNC_LLM=2
SUMMARY_LANGUAGE=Chinese
ENABLE_LLM_CACHE=true

# 服务鉴权（本机随机生成，不入库）
LIGHTRAG_API_KEY=
