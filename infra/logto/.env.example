# Logto 自托管配置模板
# 复制为 .env 后使用：cp .env.example .env
# .env 已被根 .gitignore 忽略，不要把真实密码提交进 Git。

# 镜像版本（与实测版本一致）
LOGTO_VERSION=1.46.0

# 宿主机端口映射
LOGTO_PORT=3001
LOGTO_ADMIN_PORT=3002

# Logto 对外地址
# ENDPOINT：应用 / OIDC 端点，浏览器与后端都通过它访问
LOGTO_ENDPOINT=http://localhost:3001
# ADMIN_ENDPOINT：管理控制台地址，控制台页面路径为 /console
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# PostgreSQL（仅容器网络内部使用，不对外暴露端口）
POSTGRES_USER=logto
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=logto

# Logto 连接串，主机名是 compose 服务名 postgres
# 密码中不要使用 @ : / ? # 等需要在 URL 中转义的字符
DB_URL=postgres://logto:change-me-to-a-random-password@postgres:5432/logto
