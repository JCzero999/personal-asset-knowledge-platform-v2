# 模型 API 密钥（必填）
OPENAI_API_KEY=sk-your-api-key-here

# 兼容接口基地址（可选；使用 DeepSeek 时填 https://api.deepseek.com，留空则使用官方 OpenAI）
OPENAI_API_BASE=https://api.deepseek.com

# 模型名称（可选；如 deepseek-chat、deepseek-reasoner、gpt-4o-mini）
OPENAI_MODEL_NAME=deepseek-chat

# ─────────────────────────────────────────────
# Next.js 业务应用（本地开发默认值）
# ─────────────────────────────────────────────
APP_URL=http://localhost:3000

# 身份模式：mock = 本地固定会话（开发默认）；logto = 真实登录；留空时生产环境视为未接登录
AUTH_MODE=mock

# 业务库（SQLite）：留空使用 data/app.db
DATABASE_PATH=

# Logto：AUTH_MODE=logto 时必填；真实值写在 .env.local，不要入库
# 回调地址需与控制台应用一致：APP_URL + /api/logto/sign-in-callback
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_COOKIE_SECRET=

# RAGFlow：Phase 2 真实接入前保持为空，禁止填写臆测地址或密钥
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=

# 内容库（ADR-007 单一 Dataset）：优先用 ID；留空则按名称查找，缺失时自动创建
# 真实值写在 .env.local，不要入库
RAGFLOW_DATASET_ID=
RAGFLOW_DATASET_NAME=

# 进程内 outbox worker：把元数据变更投递到 RAGFlow
# 未配置 RAGFLOW_BASE_URL / RAGFLOW_API_KEY 时不启动；false 可显式关闭
SYNC_WORKER_ENABLED=true
# 轮询间隔，毫秒；小于 5000 按默认 30000 处理
SYNC_WORKER_INTERVAL_MS=30000

# Embedding：RAGFlow 与 LightRAG 共用模型，具体配置待实测
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# LightRAG 图谱服务（ADR-010）：本机 lightrag-server；真实密钥写在 .env.local
# 未配置时 /graph 显示「图谱服务未连接」，其余功能不受影响
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=

# 管理员白名单（ADR-012）：逗号分隔的 Logto sub，登录后可见「系统管理」
# 空值 = 没有管理员；AUTH_MODE=mock 时本地固定身份直接当管理员
ADMIN_SUBS=

# 系统设置加密密钥（ADR-025）：加密 settings 表里的大模型配置（含 API Key）
# 必须独立于 Logto 的 Cookie 密钥，否则轮换登录密钥会让已存 API Key 解不开
# 更换后旧密文作废，需要在「系统 → 大模型」里重新保存一次
SETTINGS_ENC_KEY=
